---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  image = '/og/default.png',
  ogType = 'website',
  structuredData,
} = Astro.props;
const canonicalUrl = canonical ?? Astro.url.href;
const siteUrl = Astro.site?.origin ?? 'https://prsdx.github.io';
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Shubham's Blog" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Shubham" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
    <!-- Theme init: run before paint to prevent flash -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <div id="cursor-spotlight" aria-hidden="true"></div>
    <slot />

    <script>
      // Global interactive polish: cursor spotlight, scroll progress & magnetic elements
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Scroll progress
      const progressBar = document.getElementById('scroll-progress');
      if (progressBar) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const h = document.documentElement.scrollHeight - window.innerHeight;
              const scrolled = h > 0 ? (window.scrollY / h) * 100 : 0;
              progressBar.style.width = scrolled + '%';
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }

      if (!prefersReducedMotion) {
        // 2. Cursor spotlight tracking
        const spotlight = document.getElementById('cursor-spotlight');
        if (spotlight) {
          let mouseX = -9999;
          let mouseY = -9999;
          let spotTicking = false;
          window.addEventListener('pointermove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            if (!spotTicking) {
              window.requestAnimationFrame(() => {
                spotlight.style.setProperty('--mouse-x', `${mouseX}px`);
                spotlight.style.setProperty('--mouse-y', `${mouseY}px`);
                spotTicking = false;
              });
              spotTicking = true;
            }
          }, { passive: true });
        }

        // 3. Magnetic button micro-interactions
        const magnetics = document.querySelectorAll('.magnetic');
        magnetics.forEach(el => {
          const btn = el as HTMLElement;
          btn.addEventListener('pointermove', (e) => {
            const rect = btn.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            btn.style.transform = `translate(${x * 0.22}px, ${y * 0.22}px)`;
          });
          btn.addEventListener('pointerleave', () => {
            btn.style.transform = 'translate(0px, 0px)';
          });
        });
      }

      // 4. Staggered reveal observer (fallback / universal for any page using .rv)
      const revealItems = document.querySelectorAll('.rv:not(.in)');
      if (revealItems.length > 0) {
        revealItems.forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = ((i % 5) * 60) + 'ms';
        });
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        revealItems.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
