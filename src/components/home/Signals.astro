---
const signals = [
  { value: "1847", label: "Codeforces", sub: "Expert rating", href: "https://codeforces.com/profile/prsdx" },
  { value: "500+", label: "DSA problems", sub: "CF + LC + CC", href: null },
  { value: "300+", label: "Contributions", sub: "GitHub", href: "https://github.com/prsdx" },
  { value: "3",    label: "Products", sub: "shipped", href: null },
];
---
<div class="signals rv" role="list" aria-label="Key stats">
  {signals.map((s) =>
    s.href ? (
      <a class="sig" role="listitem" href={s.href}>
        <b>{s.value}</b>
        <span class="sig-label">{s.label}</span>
        <span class="sig-sub">{s.sub}</span>
      </a>
    ) : (
      <div class="sig" role="listitem">
        <b>{s.value}</b>
        <span class="sig-label">{s.label}</span>
        <span class="sig-sub">{s.sub}</span>
      </div>
    )
  )}
</div>

<style>
  .signals {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 40px 0 10px;
  }

  .sig {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--text);
    transition: border-color .18s, transform .18s, box-shadow .18s;
    position: relative;
    overflow: hidden;
  }
  /* left accent bar */
  .sig::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity .18s;
  }
  a.sig:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  a.sig:hover::before { opacity: 1; }

  .sig b {
    display: block;
    font-size: 1.7rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: -.02em;
    line-height: 1;
  }
  .sig-label {
    font-size: .82rem;
    font-weight: 600;
    color: var(--text-2);
    margin-top: 4px;
  }
  .sig-sub {
    font-size: .7rem;
    color: var(--muted);
    font-family: var(--font-mono);
    letter-spacing: .03em;
  }

  @media (max-width: 768px) {
    .signals { grid-template-columns: repeat(2, 1fr); }
  }
</style>