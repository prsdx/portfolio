---
interface Props {
  title: string;
  description: string;
  stack: string[];
  github?: string;
  live?: string;
  caseStudy?: string;
}
const { title, description, stack, github, live, caseStudy } = Astro.props;
---
<article class="proj rv">
  <div class="proj-top">
    <h3>{title}</h3>
    <div class="p-links">
      {github && <a href={github} aria-label={`${title} on GitHub`}>GitHub ↗</a>}
      {live   && <a href={live}   aria-label={`${title} live demo`}>Live ↗</a>}
    </div>
  </div>
  <p>{description}</p>
  <div class="stack">
    {stack.map((t) => <code>{t}</code>)}
  </div>
  <a class="case-btn" href={caseStudy ?? '#'}>read case study →</a>
</article>

<style>
  .proj {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color .18s, transform .18s, box-shadow .18s;
    position: relative;
    overflow: hidden;
  }
  /* top amber rule — reveals on hover */
  .proj::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    opacity: 0;
    transition: opacity .2s;
  }
  .proj:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .proj:hover::after { opacity: 1; }

  .proj-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .proj h3 {
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -.01em;
  }

  .p-links {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .p-links a {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--muted);
    text-decoration: none;
    transition: color .15s;
  }
  .p-links a:hover { color: var(--accent2); }

  .proj > p {
    color: var(--text-2);
    font-size: .9rem;
    line-height: 1.65;
    flex: 1;
  }

  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
  .stack code {
    font-family: var(--font-mono);
    font-size: .67rem;
    background: var(--chip);
    border: 1px solid var(--chip-border);
    padding: 3px 8px;
    border-radius: 5px;
    color: var(--muted);
    letter-spacing: .02em;
  }

  .case-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 10px;
    margin-top: 4px;
    border: 1px solid var(--border);
    border-radius: 7px;
    font-family: var(--font-mono);
    font-size: .76rem;
    color: var(--text-2);
    text-decoration: none;
    transition: border-color .15s, color .15s, background .15s;
    font-weight: 500;
  }
  .case-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }
</style>