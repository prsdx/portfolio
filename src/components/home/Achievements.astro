---
interface Achievement {
  place: string;
  event: string;
  year: string;
}

const achievements: Achievement[] = [
  { place: "1st", event: "Hackathon Name", year: "2025" },
  { place: "Top 10%", event: "Another Event", year: "2024" },
  { place: "100-day", event: "coding streak", year: "2025" },
];
---
<ul class="ach-list rv">
  {achievements.map((a) => (
    <li>
      <span class="ach-place">{a.place}</span>
      <span class="ach-event">{a.event}</span>
      <span class="ach-year">{a.year}</span>
    </li>
  ))}
</ul>

<style>
  .ach-list { list-style: none; border-top: 1px solid var(--border); }
  .ach-list li {
    display: flex;
    gap: 16px;
    padding: 12px 2px;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .ach-place {
    font-family: var(--font-mono);
    font-size: .75rem;
    color: var(--accent2);
    min-width: 70px;
  }
  .ach-event { color: var(--text); font-size: .9rem; }
  .ach-year {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--muted);
    margin-left: auto;
  }
</style>